---
import GithubIcon from "../assets/github.svg";
import LinkedinIcon from "../assets/linkedin.svg";
import TwitterIcon from "../assets/twitter.svg";

/**
 * Tiny util to join tailwind classes
 */
function join(...args: string[]) {
  return args.join(" ");
}
---

<div
  class={join(
    "grid grid-cols-[min-content_auto] md:grid-cols-[max-content_max-content] lg:grid-cols-[1fr_min-content_1fr]",
    "gap-x-10 gap-y-8 lg:gap-y-2 min-sm:max-md:gap-y-2 max-sm:gap-x-0",
    "p-8 pb-0 max-w-6xl m-auto",
    "text-teal-900 text-md"
  )}
>
  <div
    class="max-sm:justify-self-center col-start-2 md:col-start-1 lg:justify-self-end lg:self-end self-start"
  >
    <h1>Fabien Bernard</h1>
    <h2>Fullstack TypeScript Engineer</h2>
  </div>
  <div
    class={join(
      // Small screen - Links are in a floating bar
      "max-sm:fixed",
      "max-sm:bottom-4",
      "max-sm:left-1/2",
      "max-sm:-translate-x-1/2",
      "max-sm:rounded-full",
      "max-sm:bg-teal-400/80",
      "max-sm:shadow-2xl",
      "max-sm:px-10",
      "max-sm:py-2",
      "max-sm:justify-between",
      "max-sm:flex gap-8",

      // Small to medium - Links are under the title
      "min-sm:max-md:col-start-2",
      "min-sm:max-md:justify-self-start",
      "min-sm:max-md:justify-self-start",

      // Large screen - Links are in the corner top
      "lg:pr-18 lg:pt-2 justify-self-end self-start lg:col-start-1 lg:justify-self-end",

      // Text
      "text-lg text-teal-900 underline underline-offset-4"
    )}
  >
    <a
      href="https://github.com/fabien0102"
      target="_blank"
      class="flex gap-3 items-center"
      ><GithubIcon class="fill-teal-900 size-6" /><span class="max-sm:hidden"
        >@fabien0102</span
      ></a
    >
    <a
      href="https://x.com/fabien0102"
      target="_blank"
      class="flex gap-3 items-center"
      ><TwitterIcon class="fill-teal-900 size-6" /><span class="max-sm:hidden"
        >@fabien0102</span
      ></a
    >
    <a
      href="https://www.linkedin.com/in/fabien0102"
      target="_blank"
      class="flex gap-3 items-center"
      ><LinkedinIcon class="fill-teal-900 size-6" /><span class="max-sm:hidden"
        >/fabien0102</span
      ></a
    >
  </div>
  <div
    class={join(
      // Small screen - Profile picture take the full width
      "max-sm:col-span-2",

      // Medium screen - Profile picture is on the left
      "col-start-1 flex items-end justify-center",

      // Small to Medium - Links are under the title, so the picture needs to take 2 rows
      "max-md:row-start-1",
      "min-sm:max-md:row-start-1",
      "min-sm:max-md:row-span-2",
      "min-sm:max-md:items-center",

      // Large screen - Profile picture is centered
      "lg:col-start-2 lg:row-span-2 lg:row-start-1"
    )}
  >
    <div
      class="size-40 md:size-60 rounded-full bg-[url(/fabien-bernard.png)] bg-cover border-4 border-teal-700"
    >
    </div>
  </div>
  <div
    class={join(
      "md:col-span-1 col-span-2 self-center with-quotes order-3 pr-3 md:max-w-md lg:col-start-3 lg:row-span-2 lg:row-start-1",
      "max-md:my-8 max-md:mx-8"
    )}
  >
    <p>
      The beauty is in simplicity, creating complex piece of software follow the
      same rule. I enjoy creating nice product (with amazing UX) and tooling
      (with amazing DX) that are simple to use and maintain (testability and
      observability are keys).
    </p>
    <p>
      Any complex problem can be split in a smaller one. I also apply this
      principles in my hobbies, such as woodworking and climbing. With this
      mindset, nothing is impossible!
    </p>
  </div>
</div>

<style>
  @reference "../styles/global.css";

  h1 {
    @apply text-4xl text-teal-600 font-bold;
  }
  h2 {
    @apply text-xl text-teal-700;
  }
  p:not(:last-of-type) {
    @apply pb-2;
  }

  .with-quotes {
    @apply relative;
  }
  .with-quotes::before {
    content: "“";
    @apply absolute -top-7 -left-7 text-7xl font-serif;
  }
  .with-quotes::after {
    content: "”";
    @apply absolute -bottom-20 right-0 text-7xl font-serif lg:-bottom-14 lg:-right-4;
  }
</style>
