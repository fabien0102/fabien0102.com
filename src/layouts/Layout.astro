---
const meta = {
  title: "@fabien0102 website",
  description: "TypeScript engineer, software craftsmanship",
  image: "https://fabien0102.com/social-card.jpg",
  url: "https://fabien0102.com",
  author: "@fabien0102",
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>@fabien0102</title>
    {/* Twitter meta */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={meta.author} />
    <meta name="twitter:creator" content={meta.author} />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={meta.image} />
    {/* Open graph meta */}
    <meta property="og:url" content={meta.url} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:image" content={meta.image} />
  </head>
  <body>
    <slot />
    <div class="background"></div>
  </body>
</html>

<style>
  @reference "../styles/global.css";

  html {
    @apply bg-teal-200/50;
  }
  html,
  body {
    margin: calc(var(--spacing) * 4) 0;
    width: 100%;
    height: 100%;

    .background {
      @apply fixed w-screen h-screen top-0 bg-linear-to-r from-indigo-500/60 to-pink-500/40 mask-t-from-0 -z-10;
    }
  }
</style>
